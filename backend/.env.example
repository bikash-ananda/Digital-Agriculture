NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digital_agriculture
JWT_SECRET=change_this_long_random_secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Set to the number of trusted reverse proxies in front of Express.
TRUST_PROXY_HOPS=0
