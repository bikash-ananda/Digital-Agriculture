NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digital_agriculture
JWT_SECRET=change_this_long_random_secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Set to the number of trusted reverse proxies in front of Express.
TRUST_PROXY_HOPS=0
# Account verification: email codes use SMTP; mobile codes use Twilio WhatsApp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Login-page support chat relay (requires a WhatsApp-enabled Twilio sender and public HTTPS webhook).
SUPPORT_WHATSAPP_ADMIN=
TWILIO_SUPPORT_CONTENT_SID=
TWILIO_SUPPORT_WEBHOOK_URL=

# One-time initial super-admin bootstrap. Keep credentials in the ignored .env file.
SUPER_ADMIN_EMAIL=bikashengineering100@gmail.com
SUPER_ADMIN_PHONE=
SUPER_ADMIN_NAME=System Administrator
SA_PASSWORD=
OTP_SECRET=
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
EXPORT_SECRET=change_this_long_random_secret

# Optional; server-side key for Google Maps Platform Weather API. Keep this out of frontend env files.
GOOGLE_WEATHER_API_KEY=

# Server-side farming assistant provider. For local inference, enable the local-ai Compose profile,
# then set provider=ollama and choose an Ollama model. No model key is sent to the browser.
FARMING_AI_PROVIDER=
FARMING_OLLAMA_URL=http://ollama:11434
OLLAMA_MEM_LIMIT=6g
OLLAMA_CPUS=2.0
FARMING_EMBEDDING_MODEL=embeddinggemma-2:270m
# Optional OpenAI-compatible provider. Never put this key in frontend/.env.
FARMING_AI_URL=
FARMING_AI_API_KEY=
FARMING_AI_MODEL=qwen3.5:4b
# Enable only when the configured model endpoint supports image inputs.
FARMING_CROP_DOCTOR_ENABLED=false

# MCP is disabled until a long random bearer token is configured here and in the server environment.
AGRI_MCP_TOKEN=

# Optional coturn relay for WebRTC calls on restrictive networks.
# These are not forwarded by the current production compose configuration.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
